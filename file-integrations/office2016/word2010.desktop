[Desktop Entry]
Name=Microsoft Word 2016 (Bottles)
Exec=bash -c "flatpak run --command=bottles-cli com.usebottles.bottles run -p 'WINWORD' -b 'office2016-winecx' -- $(echo \\'z:\\"%f\\"\\' | sed 's!/!\\\\\\\\\\\\\\\\!g')"
Type=Application
Terminal=false
Icon=/home/$USER/.var/app/com.usebottles.bottles/data/bottles/bottles/office2016-winecx/icons/WINWORD.png
Comment=Launch Microsoft Word 2016 using Bottles.
StartupWMClass=Microsoft Word 2016 (Bottles)
Actions=Configure;
Categories=Application;Office;Wine;
[Desktop Action Configure]
Name=Configure in Bottles
Exec=flatpak run com.usebottles.bottles -b 'office2016-winecx'