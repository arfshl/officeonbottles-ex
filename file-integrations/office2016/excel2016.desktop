[Desktop Entry]
Name=Microsoft Excel 2016 (Bottles)
Exec=flatpak run --command=bottles-cli --file-forwarding "com.usebottles.bottles" run -p "EXCEL" -b "office2016-winecx" -- @@u %u @@
Type=Application
Terminal=false
Icon=/home/$USER/.var/app/com.usebottles.bottles/data/bottles/bottles/office2016-winecx/icons/EXCEL.png
Comment=Launch Microsoft Excel 2016 using Bottles.
StartupWMClass=Microsoft Excel 2016 (Bottles)
Actions=Configure;
Categories=Application;Office;Wine;
[Desktop Action Configure]
Name=Configure in Bottles
Exec=flatpak run com.usebottles.bottles -b 'office2016-winecx'
