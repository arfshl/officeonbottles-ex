[Desktop Entry]
Name=Microsoft PowerPoint 2010 (Bottles)
Exec=bash -c "flatpak run --command=bottles-cli com.usebottles.bottles run -p 'POWERPNT' -b 'office2010-winecx' -- $(echo \\'z:\\"%f\\"\\' | sed 's!/!\\\\\\\\\\\\\\\\!g')"
Type=Application
Terminal=false
Icon=/home/$USER/.var/app/com.usebottles.bottles/data/bottles/bottles/office2010-winecx/icons/POWERPNT.png
Comment=Launch Microsoft PowerPoint 2010 using Bottles.
StartupWMClass=Microsoft PowerPoint 2010 (Bottles)
Actions=Configure;
Categories=Application;Office;Wine;
[Desktop Action Configure]
Name=Configure in Bottles
Exec=flatpak run com.usebottles.bottles -b 'office2010-winecx'