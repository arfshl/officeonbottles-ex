[Desktop Entry]
Name=Microsoft Word 2010 (Bottles)
Exec=flatpak run --command=bottles-cli --file-forwarding "com.usebottles.bottles" run -p "WINWORD" -b "office2010-winecx" -- @@u %u @@
Type=Application
Terminal=false
Icon=/home/$USER/.var/app/com.usebottles.bottles/data/bottles/bottles/office2010-winecx/icons/WINWORD.png
Comment=Launch Microsoft Word 2010 using Bottles.
StartupWMClass=Microsoft Word 2010 (Bottles)
Actions=Configure;
Categories=Application;Office;Wine;
[Desktop Action Configure]
Name=Configure in Bottles
Exec=flatpak run com.usebottles.bottles -b 'office2010-winecx'