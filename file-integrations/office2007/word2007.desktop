[Desktop Entry]
Name=Microsoft Word 2007 (Bottles)
Exec=flatpak run --command=bottles-cli --file-forwarding "com.usebottles.bottles" run -p "WINWORD" -b "office2007-winecx" -- @@u %u @@
Type=Application
Terminal=false
Icon=/home/$USER/.var/app/com.usebottles.bottles/data/bottles/bottles/office2007-winecx/icons/WINWORD.png
Comment=Launch Microsoft Word 2007 using Bottles.
StartupWMClass=WINWORD2007
Actions=Configure;
Categories=Application;Office;Wine;
[Desktop Action Configure]
Name=Configure in Bottles
Exec=flatpak run com.usebottles.bottles -b 'office2007-winecx'